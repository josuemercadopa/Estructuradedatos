+ ejemplo de una cola (QUEUE) basada en un arreglo estático      +
+---------------------------------------------------------------*/
#include <iostream> // Corregido: sin .h***************

using namespace std; // Corregido: necesario para cout/cin****************

#define MAX_SIZE 256 
typedef char almacen[MAX_SIZE];

class Queue {
private: // Agregado por buena práctica, aunque opcional**********
    int cabeza; 
    int cola; 
    int ITEMS; 
    almacen alma; 

public:
    Queue();
    ~Queue();
    int put(char d);
    int get();
    int empty();   
    int size();
};

Queue::Queue() {
        cabeza = 0;
        cola = 0;
        ITEMS = 0;
    }

Queue::~Queue() {}

int Queue::empty() { return ITEMS == 0; }

    // Insertar elemento
    
int Queue::put(char d) // Cambiado a char para coincidir con el almacen********************
{
    if ( ITEMS == MAX_SIZE) return -1;
    if ( cola >= MAX_SIZE) { cola = 0; }
    alma[cola] = d;
    cola ++;
    ITEMS ++;
    return d;
}

    // retirar elemento
    
int Queue::get() {
        if (empty()) return -1; 
        
        char d = alma[cabeza];
        cabeza = (cabeza + 1) % MAX_SIZE; 
        ITEMS--;
        return d;
    }

    // regresa el n£mero de elementos en lista
    
int Queue::size() { return ITEMS; }


int main() {
    Queue q;

    // Llenar con el abecedario como en el original (Cambio se agrega Char)**************
    for (int d = 'A'; d <= 'Z'; d++) q.put((char)d);

    cout << "Items = " << q.size() << endl;

    while (q.size()) {
        cout << (char)q.get() << " ";
    }

    cout << "\nPara terminar oprima <Enter> ...";
    cin.get(); 
    return 0;
}
