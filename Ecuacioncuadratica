    cin >> a;
    cout << "Ingrese b:";
    cin >> b;
    cout << "Ingrese c:";
    cin >> c;
    // Llamada a la función
    d = discriminante(a, b, c); //Colocar solo el nombre de la variable
    if (d == 0) 
        cout << "La solucion unica es:" << unica(b, a);
    else 
        if (d > 0) {
            X1 = solucionreal(a, b, c, d, X2);
