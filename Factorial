def factorial(n):
    # Caso base: para evitar que la función se llame infinitamente
    if n == 0 or n == 1:
        return 1
    # Caso recursivo: n * (n-1)!
    else:
        return n * factorial(n - 1)

# Solicitar el valor al usuario
try:
    numero = int(input("Ingresá el número para calcular su factorial: "))

    if numero < 0:
        print("Lo siento, el factorial no está definido para números negativos.")
    else:
        resultado = factorial(numero)
        print(f"El factorial de {numero} es {resultado}")

except ValueError:
    print("¡Error! Por favor, ingresá un número entero válido.")
    
    
