// Función Invertir Frase
string invfrase(string frase) {
    string fraseinv = "";
    // Recorremos la frase desde el último carácter hasta el primero
    for (int i = frase.length() - 1; i >= 0; i--) {
        fraseinv += frase[i];
    }
    return fraseinv;
}
// Función Quitar Vocales
    string quitarVocal(string frase){
        string aux = "";
        for (int i = 0; i < frase.lenght(); i++)
            if (frase[i] != 'a' && frase[i] != 'e' && frase[i] != 'i' && frase[i] != 'o' && frase[i] != 'u' && frase[i] != 'A' && frase[i] != 'E' && frase[i] != 'I' && frase[i] != 'O' && frase[i] != 'U')
                aux += frase[i];
        return aux;
    }
