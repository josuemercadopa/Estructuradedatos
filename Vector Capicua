#include <iostream>
#include <vector>

using namespace std;

bool esCapicua(const vector<int>& v) {
    int n = v.size();
    for (int i = 0; i < n / 2; i++) {
        if (v[i] != v[n - 1 - i]) {
            return false; 
        }
    }
    return true;
}

int main() {
    int n;
    cout << "Ingrese el tamaño del vector: ";
    cin >> n;

    vector<int> datos(n);
    cout << "Ingrese los elementos del vector:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> datos[i];
    }

    if (esCapicua(datos)) {
        cout << "El vector es capicúa." << endl;
    } else {
        cout << "El vector NO es capicúa." << endl;
    }

    return 0;
}
